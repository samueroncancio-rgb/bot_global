# Configuración de Entorno - orderflow-bot
# NUNCA incluyas claves reales en este archivo ni lo subas con credenciales.

# Modo de operación: replay | paper | testnet | live (por defecto paper)
BOT_MODE=paper

# Binance USDⓈ-M Futures (sin permisos de retiro bajo ninguna circunstancia)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Claves de lectura para otros exchanges (opcionales; la mayoría de streams son públicos)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
HYPERLIQUID_WALLET_ADDRESS=

# Event Bus (Redpanda / Kafka)
BUS_TYPE=memory
REDPANDA_BROKERS=localhost:19092

# Lakehouse / Almacenamiento S3 (MinIO o Local)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/lakehouse
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_BRONZE=lakehouse-bronze
S3_BUCKET_SILVER=lakehouse-silver
S3_BUCKET_GOLD=lakehouse-gold

# Observabilidad (Prometheus)
METRICS_PORT=8000
HEALTH_PORT=8080

# Módulo LLM Offline (Fuera de la ruta de decisión)
# Proveedor: gemini | openai_compat
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

